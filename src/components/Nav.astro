---
const links = [
  { href: '/public-land-threats/', label: 'Threats' },
  { href: '/maps/', label: 'Maps' },
  { href: '/articles/', label: 'Articles' },
  { href: '/links/', label: 'Follow' },
  { href: '/about/', label: 'About' },
  { href: '/work-with-us/', label: 'Work With Us' },
];
---
<header class="nav">
  <div class="wrap nav-inner">
    <a href="/" class="brand">
      <img class="brand-mark" src="/images/brand-avatar.jpg" alt="Public Land Lovers" width="40" height="40" />
      <span class="brand-name">Public Land Lovers</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
  }
  .brand:hover { text-decoration: none; }
  .brand-mark {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 1.5px solid var(--ink);
    flex-shrink: 0;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }
  nav ul {
    list-style: none;
    display: flex;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  nav a:hover { color: var(--rust); text-decoration: none; }

  @media (max-width: 640px) {
    .nav-inner { flex-direction: column; align-items: flex-start; gap: 0.9rem; }
    nav ul { flex-wrap: wrap; gap: 1rem 1.2rem; }
    .brand-name { font-size: 1rem; }
  }
</style>
