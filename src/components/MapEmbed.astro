---
const { src, title = "Interactive map" } = Astro.props;
---
<section class="map-embed-wrap" data-map-embed-wrap>
  <div class="map-embed-inner">
    <div class="map-embed">
      <iframe
        src={src}
        title={title}
        loading="lazy"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>
<style>
  .map-embed-wrap {
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
  }
  .map-embed-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }
  .map-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line);
    border-radius: 3px;
    overflow: hidden;
    background: var(--paper-dark);
  }
  .map-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
<script>
  function breakoutMapEmbeds() {
    document.querySelectorAll('[data-map-embed-wrap]').forEach((el) => {
      el.style.marginLeft = '0px';
      el.style.width = '';
      const leftOffset = el.getBoundingClientRect().left;
      el.style.marginLeft = `${-leftOffset}px`;
      el.style.width = `${window.innerWidth}px`;
    });
  }
  breakoutMapEmbeds();
  window.addEventListener('resize', breakoutMapEmbeds);
</script>