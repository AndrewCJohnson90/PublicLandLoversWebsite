---
import Base from '../../layouts/Base.astro';
---
<Base title="Work With Us" description="Environmental, ecological, and geospatial consulting from Orovada Consulting LLC — the team behind Public Land Lovers.">
  <section class="section">
    <div class="wrap work-grid">
      <div>
        <p class="eyebrow">Orovada Consulting LLC</p>

        <h1>We work where people, science, and public lands meet.</h1>

        <p class="lede">
          Public Land Lovers is built on the same skills we use through Orovada Consulting.
          We explore public lands, collect data, build maps, document what we find, and
          turn complicated information into something people can actually understand and use.
        </p>

        <p>
          Our work brings together ecology, environmental monitoring, GIS, field data,
          photography, and storytelling. Whether you need help understanding a landscape,
          organizing field data, building a mapping tool, documenting a project, or telling
          an environmental story, we can help turn an idea into something useful.
        </p>

        <ul class="services">
          <li>Ecology &amp; environmental monitoring</li>
          <li>GIS, mapping &amp; geospatial analysis</li>
          <li>Field data collection &amp; data management</li>
          <li>Remote sensing, LiDAR &amp; terrain analysis</li>
          <li>Python automation &amp; spatial data pipelines</li>
          <li>Environmental storytelling &amp; visual communication</li>
          <li>Custom maps, web maps &amp; interactive tools</li>
        </ul>
      </div>

      <form class="lead-form" method="POST" action="/api/lead">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" required />

        <label for="org">Organization</label>
        <input id="org" name="org" type="text" />

        <label for="email">Email</label>
        <input id="email" name="email" type="email" required />

        <label for="project">Project type</label>
        <select id="project" name="project">
          <option>GIS / mapping project</option>
          <option>Python / data pipeline</option>
          <option>Field data collection</option>
          <option>Something else</option>
        </select>

        <label for="message">What are you working on?</label>
        <textarea id="message" name="message" rows="4"></textarea>

        <button class="btn btn-solid" type="submit">Send it over</button>
        <p class="form-note">
          Routes to a Cloudflare Pages Function at <code>/api/lead</code> &mdash;
          see <code>functions/api/lead.js</code> to wire up email delivery
          (Resend, SendGrid, etc.), or swap this form's <code>action</code>
          for a Formspree endpoint for a zero-backend option.
        </p>
      </form>
    </div>
  </section>
</Base>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .lede { color: var(--ink-soft); font-size: 1.05rem; }
  .services {
    margin-top: 1.5rem;
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .services li { padding-left: 1.1rem; position: relative; }
  .services li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--rust);
  }
  .lead-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--paper-dark);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 1.75rem;
  }
  .form-note {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .form-note code {
    background: rgba(42,40,32,0.08);
    padding: 0.1rem 0.3rem;
    border-radius: 2px;
  }
  @media (max-width: 800px) {
    .work-grid { grid-template-columns: 1fr; }
  }
</style>
