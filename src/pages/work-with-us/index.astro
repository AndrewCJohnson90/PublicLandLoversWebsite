---
import Base from '../../layouts/Base.astro';
---
<Base title="Work With Us" description="GIS and geospatial consulting from Orovada Consulting LLC — the team behind Public Land Lovers.">
  <section class="section">
    <div class="wrap work-grid">
      <div>
        <p class="eyebrow">Orovada Consulting LLC</p>
        <h1>The maps on this site are the portfolio.</h1>
        <p class="lede">
          Every map you've seen here — feature services, LiDAR-derived
          terrain models, field data pipelines — was built by the same
          team that runs Orovada Consulting. If you need GIS, remote sensing,
          or geospatial data pipeline work done well, this is what we do.
        </p>
        <ul class="services">
          <li>ArcGIS Pro &amp; ArcGIS Online project builds</li>
          <li>Python automation for spatial data pipelines</li>
          <li>Field data collection &amp; feature service design</li>
          <li>LiDAR processing &amp; terrain analysis</li>
        </ul>
      </div>

      <div class="form-panel">
        <form id="lead-form" class="lead-form" name="contact" onsubmit="handleLeadSubmit(event)">
          <!-- Submits into Orovada's existing Netlify Forms dashboard —
               field names below intentionally match orovada.com's contact
               form exactly so submissions land there identically. -->
          <input type="hidden" name="form-name" value="contact" />
          <p class="honeypot"><label>Don't fill this out: <input name="bot-field" /></label></p>

          <div class="form-row">
            <div class="field">
              <label for="first-name">First Name</label>
              <input id="first-name" name="first-name" type="text" required />
            </div>
            <div class="field">
              <label for="last-name">Last Name</label>
              <input id="last-name" name="last-name" type="text" required />
            </div>
          </div>

          <label for="organization">Organization</label>
          <input id="organization" name="organization" type="text" />

          <label for="email">Email</label>
          <input id="email" name="email" type="email" required />

          <label for="service">Service Area</label>
          <select id="service" name="service" required>
            <option value="">Select a service area</option>
            <option>Environmental Consulting &amp; Botanical Surveying</option>
            <option>GIS &amp; Geospatial Services</option>
            <option>Media Production &amp; Digital Marketing</option>
            <option>Multiple Services</option>
          </select>

          <label for="message">Project Description</label>
          <textarea id="message" name="message" rows="4" required></textarea>

          <button class="btn btn-solid" type="submit">Send it over</button>

        </form>

        <div id="lead-success" class="lead-success" hidden>
          <p class="success-title">Message received</p>
          <p>Thanks for reaching out — we'll review your project details and get back to you within 1–2 business days.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  function handleLeadSubmit(event) {
    event.preventDefault();
    const form = event.target;
    const data = new FormData(form);

    // mode: 'no-cors' because this is a cross-domain submission (this site
    // is publiclandlovers.com, the form lives on orovada.com's Netlify
    // Forms). The browser blocks JS from reading the response in that
    // case, but the POST itself still reaches Netlify and gets recorded —
    // so we just show our own success state rather than relying on a
    // response we can't see.
    fetch('https://orovada.com/', {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(data).toString(),
    }).finally(() => {
      form.hidden = true;
      document.getElementById('lead-success').hidden = false;
    });
  }
</script>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .lede { color: var(--ink-soft); font-size: 1.05rem; }
  .services {
    margin-top: 1.5rem;
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .services li { padding-left: 1.1rem; position: relative; }
  .services li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--rust);
  }
  .form-panel {
    background: var(--paper-dark);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 1.75rem;
  }
  .lead-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .honeypot { display: none; }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .form-note {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .lead-success {
    text-align: center;
    padding: 2rem 1rem;
  }
  .success-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }
  @media (max-width: 800px) {
    .work-grid { grid-template-columns: 1fr; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>