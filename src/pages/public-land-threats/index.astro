---
import Base from '../../layouts/Base.astro';
import Contour from '../../components/Contour.astro';
import { getCollection } from 'astro:content';

const threats = (await getCollection('threats')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Threats to Public Lands" description="Tracking the biggest current threats to America's public lands, place by place.">
  <section class="section hero-small">
    <div class="wrap">
      <p class="eyebrow">Threats to Public Lands</p>
      <h1>Threats to Public Lands</h1>
      <p class="lede">The places under the most pressure right now, and what's actually being proposed at each one.</p>
    </div>
  </section>

  <Contour variant="divider" tone="light" />

  <section class="section">
    <div class="wrap">
      <div class="map-list">
        {threats.map((t) => (
          <a class="card map-row" href={`/public-land-threats/${t.id}/`}>
            <div>
              <h3>{t.data.title}</h3>
              <p>{t.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-small { padding-bottom: 1rem; }
  .lede { max-width: 34rem; color: var(--ink-soft); font-size: 1.05rem; }
  .map-list { display: flex; flex-direction: column; gap: 1rem; }
  .map-row {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .map-row:hover { border-color: var(--rust); text-decoration: none; }
</style>
