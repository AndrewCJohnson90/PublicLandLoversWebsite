---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { notDraft } from '../../../lib/content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', notDraft);
  return articles.map((a) => ({ params: { id: a.id }, props: { entry: a } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.pubDate.toISOString(),
  author: { '@type': 'Organization', name: 'Public Land Lovers' },
  publisher: {
    '@type': 'Organization',
    name: 'Public Land Lovers',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/images/brand-avatar.jpg', Astro.site).toString(),
    },
  },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
---
<Base title={entry.data.title} description={entry.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <section class="section article-header">
    <div class="wrap content-body">
      <p class="coord">
        {entry.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        {entry.data.tags.length > 0 && <> &middot; {entry.data.tags.join(' · ')}</>}
      </p>
      <h1>{entry.data.title}</h1>
    </div>
  </section>

  <section class="wrap content-body article-body">
    <Content />
    <p><a class="btn" href="/articles/">&larr; All articles</a></p>
  </section>
</Base>

<style>
  .article-header { padding-bottom: 1rem; }
  .content-body { max-width: 42rem; }
  .article-body { padding-bottom: 4rem; }
  .article-body :global(h2) { margin-top: 2rem; }
  .article-body :global(p) { color: var(--ink); }
</style>
