---
import Base from '../../layouts/Base.astro';
---
<Base title="Work With Us" description="GIS and geospatial consulting from Orovada Consulting LLC — the team behind Public Land Lovers.">
  <section class="section">
    <div class="wrap work-grid">
      <div>
        <p class="eyebrow">Orovada Consulting LLC</p>
        <h1>The maps on this site are the portfolio.</h1>
        <p class="lede">
          Every map you've seen here &mdash; feature services, LiDAR-derived
          terrain models, field data pipelines &mdash; was built by the same
          team that runs Orovada Consulting. If you need GIS, remote sensing,
          or geospatial data pipeline work done well, this is what we do.
        </p>
        <ul class="services">
          <li>ArcGIS Pro &amp; ArcGIS Online project builds</li>
          <li>Python automation for spatial data pipelines</li>
          <li>Field data collection &amp; feature service design</li>
          <li>LiDAR processing &amp; terrain analysis</li>
        </ul>
      </div>

      <form class="lead-form" method="POST" action="/api/lead">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" required />

        <label for="org">Organization</label>
        <input id="org" name="org" type="text" />

        <label for="email">Email</label>
        <input id="email" name="email" type="email" required />

        <label for="project">Project type</label>
        <select id="project" name="project">
          <option>GIS / mapping project</option>
          <option>Python / data pipeline</option>
          <option>Field data collection</option>
          <option>Something else</option>
        </select>

        <label for="message">What are you working on?</label>
        <textarea id="message" name="message" rows="4"></textarea>

        <button class="btn btn-solid" type="submit">Send it over</button>
        <p class="form-note">
          Routes to a Cloudflare Pages Function at <code>/api/lead</code> &mdash;
          see <code>functions/api/lead.js</code> to wire up email delivery
          (Resend, SendGrid, etc.), or swap this form's <code>action</code>
          for a Formspree endpoint for a zero-backend option.
        </p>
      </form>
    </div>
  </section>
</Base>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .lede { color: var(--ink-soft); font-size: 1.05rem; }
  .services {
    margin-top: 1.5rem;
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .services li { padding-left: 1.1rem; position: relative; }
  .services li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--rust);
  }
  .lead-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--paper-dark);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 1.75rem;
  }
  .form-note {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .form-note code {
    background: rgba(42,40,32,0.08);
    padding: 0.1rem 0.3rem;
    border-radius: 2px;
  }
  @media (max-width: 800px) {
    .work-grid { grid-template-columns: 1fr; }
  }
</style>
