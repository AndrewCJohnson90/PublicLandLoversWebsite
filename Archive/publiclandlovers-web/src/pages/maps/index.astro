---
import Base from '../../layouts/Base.astro';
import Contour from '../../components/Contour.astro';
import { getCollection } from 'astro:content';

const maps = await getCollection('maps');
---
<Base title="Maps" description="Interactive maps built with ArcGIS Pro and ArcGIS Online, from van life road trips to stream restoration assessments.">
  <section class="section hero-small">
    <div class="wrap">
      <p class="eyebrow">Interactive Mapping</p>
      <h1>Maps</h1>
      <p class="lede">Every map here is built from real fieldwork &mdash; GPS tracks, LiDAR, and photo waypoints, pushed into ArcGIS Online feature services with Python.</p>
    </div>
  </section>

  <Contour variant="divider" tone="light" />

  <section class="section">
    <div class="wrap">
      <div class="map-list">
        {maps.map((m) => (
          <a class="card map-row" href={`/maps/${m.id}/`}>
            <div>
              <h3>{m.data.title}</h3>
              <p>{m.data.description}</p>
            </div>
            {m.data.region && <p class="coord region">{m.data.region}</p>}
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-small { padding-bottom: 1rem; }
  .lede { max-width: 34rem; color: var(--ink-soft); font-size: 1.05rem; }
  .map-list { display: flex; flex-direction: column; gap: 1rem; }
  .map-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .map-row:hover { border-color: var(--rust); text-decoration: none; }
  .region { white-space: nowrap; }
  @media (max-width: 640px) {
    .map-row { flex-direction: column; align-items: flex-start; }
  }
</style>
